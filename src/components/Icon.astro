---
// Line icon from src/data/icons.ts, drawn inline (no icon font needed).
import { icons } from '../data/icons';
const { name, size = 20, class: cls = '' } = Astro.props;
---
<svg class={`icon ${cls}`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[name]} />
