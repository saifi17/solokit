---
// SoloKit mark: a path from a starting ring ("yes") to a filled dot ("paid").
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="9" fill="#0F6B58" />
  <circle cx="10" cy="22" r="3" fill="none" stroke="#fff" stroke-width="2.2" />
  <path d="M10 19c0-6.5 12-3.5 12-9.5" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
  <circle cx="22" cy="8.6" r="3.1" fill="#fff" />
</svg>
