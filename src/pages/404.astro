---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Page not found | SoloKit" description="This page doesn't exist.">
  <div class="wrap page">
    <h1>This page doesn't exist</h1>
    <p class="lede">The link may be old or mistyped. All the tools are on the home page.</p>
    <p><a class="btn btn-primary" href={base}>Go to all tools</a></p>
  </div>
</Base>
