---
import ToolLayout from '../../layouts/ToolLayout.astro';
import MeetingPlanner from '../../islands/MeetingPlanner';

const faq: [string, string][] = [
  ['How do I find a meeting time across time zones?', 'Add your city and your clients\' cities, set the usual working hours, and the planner highlights the hours when everyone is at work. Click any hour to choose it, then copy it for an email or download a calendar invite.'],
  ['Does it handle daylight saving time?', 'Yes. Pick the date of the meeting and the planner uses the right offset for each city on that day. Clocks change on different dates in the US, Europe and elsewhere, so the gap between cities can shift for a week or two.'],
  ['What if there are no shared working hours?', 'The planner suggests the hour that asks the least of everyone. With very distant clients, one side often starts early or stays late, or you agree to work by email and recorded video instead.'],
  ['How do I send the time to my client?', 'Use "Copy for email" for a message listing the time in every city, "Calendar invite" for a file that works with Outlook, Apple Calendar and Google, or "Share link" to send a link that opens this exact plan.'],
  ['Is my location stored?', 'No. Your time zone is read from your device to choose a starting city, and your cities are saved only in your browser.'],
];
---
<ToolLayout
  slug="time-zone-meeting-planner"
  title="Time Zone Meeting Planner for Freelancers and Remote Teams | SoloKit"
  description="Find the best meeting time with clients in other countries. See shared working hours across cities, then copy the time for an email or download a calendar invite. Free."
  h1="Time zone meeting planner"
  lede="Add your clients' cities to see the working hours you share. Pick a slot, then send it as an email, a calendar invite or a link."
  trust={['Daylight saving handled', 'Calendar invites (.ics)', 'Shareable links']}
  faq={faq}
>
  <MeetingPlanner client:only="preact">
    <div slot="fallback" class="panel" style="min-height:420px"><p class="muted">Loading the meeting planner…</p></div>
  </MeetingPlanner>

  <Fragment slot="article">
    <h2>How to use it</h2>
    <ol>
      <li>The first city is the main time zone; the columns follow its hours. It starts as the time zone your device reports. Use the ↑ button to make another city the main one.</li>
      <li>Add each client's city. You can add as many as you need.</li>
      <li>Set the hours people usually work. 9 to 5 is the default.</li>
      <li>Yellow columns are the hours when everyone is working. Click any hour to choose it.</li>
      <li>Send it: copy the times for an email, download a calendar invite, or share a link.</li>
    </ol>

    <h2>Working with clients far away</h2>
    <p>Freelancers in South Asia working for US clients, or Europeans working with Australia, often share one or two working hours, or none. A few habits help:</p>
    <ul>
      <li>Offer two or three specific slots in the client's own time zone.</li>
      <li>Keep live calls for decisions. Use written updates or short recorded videos for status.</li>
      <li>Agree on a reply window, such as "within one working day", so nobody feels ignored overnight.</li>
      <li>Watch the daylight saving weeks in March, October and November, when the gap between countries shifts.</li>
    </ul>
  </Fragment>
</ToolLayout>
