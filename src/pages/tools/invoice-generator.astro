---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DocEditor from '../../islands/DocEditor';

const faq: [string, string][] = [
  ['Is this invoice generator really free?', 'Yes. There is no sign-up, no watermark and no limit on how many invoices you make.'],
  ['How do I save the invoice as a PDF?', 'Press "Download PDF". Your browser\'s print window opens: choose "Save as PDF" (or "Microsoft Print to PDF") as the printer and save. The file is named after the invoice number and client.'],
  ['Where are my invoices stored?', 'Only in your browser on this device. Every invoice is saved as you type and listed in your Workspace. To move them to another device, download a backup from the Workspace.'],
  ['What should a freelance invoice include?', 'Your name and contact details, the client\'s details, a unique invoice number, the issue and due dates, a list of the work with prices, the total, and how to pay you. Many countries also require your tax or VAT number, and EU business clients often need their VAT number on the invoice.'],
  ['What payment terms should I use?', '14 or 30 days are the most common. Shorter terms, or payment on receipt, are fine for small jobs and new clients. Put an exact due date on the invoice; SoloKit works it out from the terms you pick.'],
  ['Can I add my logo and change the design?', 'Yes. Upload a logo under "Your details", then choose one of three templates, an accent colour and A4 or US Letter paper under "Design".'],
];
---
<ToolLayout
  slug="invoice-generator"
  title="Free Invoice Generator for Freelancers (PDF, No Sign-up) | SoloKit"
  description="Create professional invoices with your logo in any currency and download them as PDF. Three templates, payment terms, tax, discounts and a PAID stamp. Free, no watermark."
  h1="Free invoice generator"
  lede="Fill in the form and watch your invoice build as you type. Add your logo, pick a template, and download a clean PDF. Mark it paid when the money arrives."
  trust={['No sign-up, no watermark', 'Any currency, A4 or Letter', 'Saved only on your device']}
  faq={faq}
>
  <DocEditor client:only="preact" type="invoice">
    <div slot="fallback" class="panel" style="min-height:560px"><p class="muted">Loading the invoice editor…</p></div>
  </DocEditor>

  <Fragment slot="article">
    <h2>How to make an invoice in a minute</h2>
    <ol>
      <li>Add your details once. They're remembered for every invoice on this device.</li>
      <li>Add the client. Clients you've billed before appear as you type.</li>
      <li>List the work, one line per deliverable or block of hours. Use "Add tracked time" to pull hours straight from the <a href="../time-tracker/">time tracker</a>.</li>
      <li>Pick payment terms, and add how the client can pay you.</li>
      <li>Press <strong>Download PDF</strong>, then use "Write the email" from the menu for a ready-made message to send with it.</li>
    </ol>

    <h2>Invoicing clients abroad</h2>
    <ul>
      <li><strong>Currency:</strong> invoice in the currency you agreed, usually the client's. Check what you'll actually receive with the <a href="../payment-fee-calculator/">payment fee calculator</a>.</li>
      <li><strong>Tax:</strong> rules depend on where you and your client are based. Selling services to a business in another country often means no local VAT on the invoice, but you may need to add a note and their VAT number. Check with an accountant in your country.</li>
      <li><strong>Payment details:</strong> give everything the client needs in one place: account name, number and bank code, or your Wise or Payoneer receiving details.</li>
      <li><strong>Paper:</strong> US and Canadian businesses expect US Letter; almost everyone else uses A4.</li>
    </ul>

    <h2>Getting paid on time</h2>
    <ul>
      <li>Send the invoice the day the work is delivered.</li>
      <li>Use an exact due date rather than "Net 30". It's harder to ignore.</li>
      <li>Address it to whoever pays, often an accounts team, and copy your main contact.</li>
      <li>If the due date passes, the <a href="../late-payment-email-generator/">payment reminder generator</a> writes a polite follow-up for you.</li>
    </ul>
  </Fragment>
</ToolLayout>
